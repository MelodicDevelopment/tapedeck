{
  "name": "tapedeck",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "author": "Rick Hopkins <support@melodic.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/MelodicDevelopment/tapedeck.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icon": "tauri icon src-tauri/icons/app-icon.svg && npm run desktop:icon:macos",
    "desktop:icon:macos": "node scripts/compile-macos-icon.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@melodicdev/core": "^3.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.5",
    "@types/youtube": "^0.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "happy-dom": "^20.11.1",
    "lucide-static": "^0.468.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
